{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/playground", "destination": "/spa.html" },
    { "source": "/status", "destination": "/spa.html" }
  ]
}
